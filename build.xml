<?xml version="1.0" encoding="UTF-8"?>
<project name="Practica2.1" default="default" basedir=".">
    <description>Compilación y pruebas locales de la práctica DBA.</description>
    <!-- NetBeans mantiene la compilación estándar en este archivo generado. -->
    <import file="nbproject/build-impl.xml"/>

    <target name="pruebas-locales" depends="compile-test"
            description="Comprueba Base, Termostato, Grid y Swing sin VPN ni token personal">
        <macrodef name="prueba-local">
            <attribute name="clase"/>
            <attribute name="directorio" default="${basedir}"/>
            <sequential>
                <java classname="@{clase}" dir="@{directorio}" fork="true"
                      failonerror="true" timeout="20000">
                    <jvmarg value="-Djava.awt.headless=true"/>
                    <classpath path="${run.test.classpath}"/>
                </java>
            </sequential>
        </macrodef>

        <prueba-local clase="base.InfraestructuraPrueba"/>
        <prueba-local clase="termostato.TermostatoPrueba"/>
        <prueba-local clase="grid.PoliticaGridPrueba"/>
        <prueba-local clase="grid.VisualizadorGridCliPrueba"/>
        <prueba-local clase="grid.control.ControladorGridPrueba"/>
        <prueba-local clase="grid.vista.MapaExploradoPrueba"/>

        <!-- JADE se ejecuta aislado: la prueba crea una configuración ficticia. -->
        <tempfile property="prueba.jade.dir" destdir="${java.io.tmpdir}" prefix="dba-jade-"/>
        <mkdir dir="${prueba.jade.dir}"/>
        <prueba-local clase="grid.control.ArranqueSinArgumentosPrueba"
                      directorio="${prueba.jade.dir}"/>
        <delete dir="${prueba.jade.dir}" quiet="true"/>
    </target>
</project>
